# Memories.ai DataLake API key — create at https://console.memories.ai (API keys)
MEMORIES_API_KEY=sk-mai-...

# Which collection to chat with. `vpi ingest` prints one; `vpi collections` lists them.
VPI_COLLECTION_ID=col_...

# LLM: Claude by default. Set ANTHROPIC_API_KEY, or point VPI_LLM_BASE_URL at any
# OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio) and set VPI_LLM_API_KEY.
ANTHROPIC_API_KEY=
VPI_LLM_MODEL=claude-opus-5
# VPI_LLM_BASE_URL=https://openrouter.ai/api/v1
# VPI_LLM_API_KEY=

# Your timezone. The API stores UTC; the agent converts both ways.
VPI_TIMEZONE=Asia/Shanghai

# Run on bundled fixtures — no key, no account, no spend.
VPI_DEMO=0
